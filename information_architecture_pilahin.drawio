        <mxCell id="sub_l1" value="• 4 Alur Sirkular (Pilah-Jemput-Uang)&lt;br&gt;• Perbandingan Solusi Nilai Nyata&lt;br&gt;• Daftar Harga Komoditas Sampah&lt;br&gt;• Call-to-Action Daftar Warga" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#222222;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">

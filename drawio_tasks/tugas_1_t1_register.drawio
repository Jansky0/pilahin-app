  <diagram id="t1_register" name="Tugas 1 - Register Warga">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr" value="&lt;b&gt;TUGAS 1: PENDAFTARAN AKUN WARGA BARU&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;font-weight:normal;color:#64748b;'&gt;Tugasan Tunggal: Warga Baru Mendaftar Akun &amp; Mengisi Alamat Penjemputan&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="45" as="geometry" />
        </mxCell>
        <mxCell id="start" value="MULAI TUGAS" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=2;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="180" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="scr" value="&lt;b&gt;LAYAR:&lt;/b&gt;&lt;br&gt;RegisterScreen.jsx (Layar Penuh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=11;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="210" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#059669;fontStyle=1;endArrow=classic;endFill=1;" edge="1" source="start" target="scr" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="act" value="&lt;b&gt;AKSI PENGGUNA:&lt;/b&gt;&lt;br&gt;1. Pilih Peran: [Warga Penyetor]&lt;br&gt;2. Ketik Nama Lengkap&lt;br&gt;3. Ketik No. WhatsApp Aktif&lt;br&gt;4. Ketik Kata Sandi&lt;br&gt;5. Ketik Alamat &amp; Patokan Rumah&lt;br&gt;6. Klik 'Daftar Akun Pilah.in'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="155" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#059669;fontStyle=1;endArrow=classic;endFill=1;" edge="1" source="scr" target="act" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="Data Lengkap &amp;&lt;br&gt;No WA &gt;= 10 Digit&lt;br&gt;&amp; Pass &gt;= 6 Char?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#92400e;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="165" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#059669;fontStyle=1;endArrow=classic;endFill=1;" edge="1" source="act" target="dec" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hp" value="&lt;b style='color:#14532d;'&gt;✅ HAPPY PATH: Registrasi Berhasil&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#166534;'&gt;Akun tersimpan, toast 'Pendaftaran berhasil!', dan langsung dialihkan masuk ke Dasbor Beranda Warga.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="970" y="120" width="260" height="75" as="geometry" />

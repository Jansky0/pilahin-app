        <mxCell id="e_hp" value="YA / VALID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2.5;fontSize=10;fontColor=#16a34a;fontStyle=1;endArrow=classic;endFill=1;" edge="1" source="dec" target="hp" parent="1">

        <mxCell id="sp" value="&lt;b style='color:#9f1239;'&gt;❌ SAD PATH: Input Tidak Lengkap / Salah&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#881337;'&gt;Toast 'Lengkapi nama, WA, dan password!' / 'WA min 10 digit'. Form ditahan, user memperbaiki input.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe4e6;strokeColor=#e11d48;strokeWidth=2;fontColor=#9f1239;fontSize=11;spacing=6;" vertex="1" parent="1">
